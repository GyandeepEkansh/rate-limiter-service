PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Set to true to run locally without a running Redis server (uses in-memory Redis mock)
USE_MOCK_REDIS=false

# Default Rate Limiter Settings
DEFAULT_ALGORITHM=token_bucket
DEFAULT_RATE=10
DEFAULT_BURST=20
DEFAULT_LIMIT=100
DEFAULT_WINDOW_SECONDS=60

# Admin API Key
ADMIN_API_KEY=admin-secret-key-123
